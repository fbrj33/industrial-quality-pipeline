[0m22:55:19.653366 [debug] [Thread-1 (]: On model.industrial_quality.mart_daily_quality_metrics: /* {"app": "dbt", "dbt_version": "1.11.16", "profile_name": "industrial_quality", "target_name": "dev", "node_id": "model.industrial_quality.mart_daily_quality_metrics"} */

  create view "quality_db"."analytics"."mart_daily_quality_metrics__dbt_tmp"
    
    
  as (
    SELECT
    CAST(event_timestamp AS DATE) AS production_date,

    COUNT(*) AS total_units,

    SUM(CASE
        WHEN quality_label = -1 THEN 1
        ELSE 0
    END) AS passed_units,

    SUM(CASE
        WHEN quality_label = 1 THEN 1
        ELSE 0
    END) AS failed_units,

    ROUND(
        100.0 * SUM(CASE
            WHEN quality_label = 1 THEN 1
            ELSE 0
        END) / NULLIF(COUNT(*), 0),
        2
    ) AS failure_rate_pct,

    ROUND(
        100.0 * SUM(CASE
            WHEN quality_label = -1 THEN 1
            ELSE 0
        END) / NULLIF(COUNT(*), 0),
        2
    ) AS pass_rate_pct

FROM "quality_db"."analytics"."stg_production_events"

GROUP BY CAST(event_timestamp AS DATE)
  );
